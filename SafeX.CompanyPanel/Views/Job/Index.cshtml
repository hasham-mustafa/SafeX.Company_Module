@model JobListViewModel
@{
    ViewData["Title"] = "My Jobs";
    ViewData["ActivePage"] = "Jobs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-briefcase"></i> My Jobs</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Jobs</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Post New Job
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" id="filterForm" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by title, skills, location..."
                           value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Draft" selected="@(Model.StatusFilter == "Draft")">Draft</option>
                    <option value="Published" selected="@(Model.StatusFilter == "Published")">Published</option>
                    <option value="Closed" selected="@(Model.StatusFilter == "Closed")">Closed</option>
                    <option value="Filled" selected="@(Model.StatusFilter == "Filled")">Filled</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Type</label>
                <select name="typeFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Types</option>
                    <option value="FullTime" selected="@(Model.TypeFilter == "FullTime")">Full Time</option>
                    <option value="PartTime" selected="@(Model.TypeFilter == "PartTime")">Part Time</option>
                    <option value="Contract" selected="@(Model.TypeFilter == "Contract")">Contract</option>
                    <option value="Internship" selected="@(Model.TypeFilter == "Internship")">Internship</option>
                    <option value="Freelance" selected="@(Model.TypeFilter == "Freelance")">Freelance</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Sort By</label>
                <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                    <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest First</option>
                    <option value="title" selected="@(Model.SortBy == "title")">Title A-Z</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Jobs.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-briefcase display-3 text-muted"></i>
            <h4 class="mt-3 text-muted">@(string.IsNullOrEmpty(Model.SearchTerm) ? "No Jobs Posted Yet" : "No Jobs Match Your Search")</h4>
            <p class="text-muted">@(string.IsNullOrEmpty(Model.SearchTerm) ? "Post your first job to start receiving applications." : "Try adjusting your search or filter criteria.")</p>
            @if (string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Post New Job
                </a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Clear Filters
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Applicants</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.Jobs)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@job.Id" class="text-decoration-none">
                                        @job.Title
                                    </a>
                                    @if (!string.IsNullOrEmpty(job.Duration))
                                    {
                                        <br><small class="text-muted"><i class="bi bi-clock"></i> @job.Duration</small>
                                    }
                                </td>
                                <td class="small text-muted">
                                    <i class="bi bi-geo-alt"></i> @(job.Location ?? "Remote")
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info">@job.EmploymentType</span>
                                </td>
                                <td>
                                    @switch (job.Status)
                                    {
                                        case SafeX.CompanyPanel.Models.JobStatus.Draft:
                                            <span class="badge bg-secondary">Draft</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.JobStatus.Published:
                                            <span class="badge bg-success">Published</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.JobStatus.Closed:
                                            <span class="badge bg-warning text-dark">Closed</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.JobStatus.Filled:
                                            <span class="badge bg-primary">Filled</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Applicant" asp-action="JobApplicants" asp-route-jobId="@job.Id"
                                       class="text-decoration-none fw-semibold">
                                        @job.Applicants.Count
                                    </a>
                                </td>
                                <td class="small text-muted">@job.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-info"
                                           title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-outline-primary"
                                           title="Edit"><i class="bi bi-pencil"></i></a>
                                        @if (job.Status == SafeX.CompanyPanel.Models.JobStatus.Draft)
                                        {
                                            <form asp-action="Publish" asp-route-id="@job.Id" method="post" class="d-inline"
                                                   onsubmit="return confirmAction(this, 'Publish this job? It will be visible to applicants.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Publish">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (job.Status == SafeX.CompanyPanel.Models.JobStatus.Published)
                                        {
                                            <form asp-action="Close" asp-route-id="@job.Id" method="post" class="d-inline"
                                                   onsubmit="return confirmAction(this, 'Close this job? It will stop receiving applications.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="Close">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="Delete" asp-route-id="@job.Id" method="post" class="d-inline"
                                               onsubmit="return confirmAction(this, 'Delete this job permanently? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <partial name="_Pagination" model='new PaginationViewModel {
        TotalCount = Model.TotalCount,
        PageNumber = Model.PageNumber,
        PageSize = Model.PageSize
    }' />
}
