@model JobDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActivePage"] = "Jobs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-briefcase"></i> @Model.Title</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Jobs</a></li>
                <li class="breadcrumb-item active">@Model.Title</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle"></i> Description</h5>
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") fs-6 px-3 py-2">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </div>
            <div class="card-body p-4">
                <p class="text-muted" style="white-space: pre-line;">@Model.Description</p>

                @if (Model.SkillsList.Any())
                {
                    <h6 class="fw-bold mt-4 mb-2"><i class="bi bi-tools"></i> Required Skills</h6>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var skill in Model.SkillsList)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">@skill</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-people"></i> Applicants (@Model.ApplicantCount)</h5>
            </div>
            <div class="card-body p-4 text-center">
                @if (Model.ApplicantCount == 0)
                {
                    <p class="text-muted mb-0">No applicants yet.</p>
                }
                <a asp-controller="Applicant" asp-action="JobApplicants" asp-route-jobId="@Model.Id"
                   class="btn btn-outline-primary mt-2">
                    <i class="bi bi-eye"></i> View Applicants
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-grid"></i> Details</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <small class="text-muted d-block">Status</small>
                    @switch (Model.Status)
                    {
                        case SafeX.CompanyPanel.Models.JobStatus.Draft:
                            <span class="badge bg-secondary fs-6 px-3 py-2">Draft</span>
                            break;
                        case SafeX.CompanyPanel.Models.JobStatus.Published:
                            <span class="badge bg-success fs-6 px-3 py-2">Published</span>
                            break;
                        case SafeX.CompanyPanel.Models.JobStatus.Closed:
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2">Closed</span>
                            break;
                        case SafeX.CompanyPanel.Models.JobStatus.Filled:
                            <span class="badge bg-primary fs-6 px-3 py-2">Filled</span>
                            break;
                    }
                </div>
                <hr />
                <div class="mb-3">
                    <small class="text-muted d-block">Employment Type</small>
                    <strong>@Model.EmploymentTypeDisplay</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Category</small>
                    <strong>@(Model.Category ?? "Not specified")</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Location</small>
                    <strong><i class="bi bi-geo-alt"></i> @(Model.Location ?? "Remote / Not specified")</strong>
                </div>
                <hr />
                <div class="mb-3">
                    <small class="text-muted d-block">Budget</small>
                    <strong class="text-success">@Model.BudgetDisplay</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Experience Level</small>
                    <strong>@(Model.ExperienceLevel ?? "Not specified")</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Duration</small>
                    <strong>@(Model.Duration ?? "Not specified")</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Positions Available</small>
                    <strong>@Model.PositionsAvailable</strong>
                </div>
                @if (Model.ApplicationDeadline.HasValue)
                {
                    <div class="mb-3">
                        <small class="text-muted d-block">Application Deadline</small>
                        <strong>@Model.ApplicationDeadline.Value.ToString("MMM dd, yyyy")</strong>
                    </div>
                }
                <hr />
                <div>
                    <small class="text-muted d-block">Created</small>
                    <strong>@Model.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</strong>
                </div>
                @if (Model.PublishedAt.HasValue)
                {
                    <div class="mt-2">
                        <small class="text-muted d-block">Published</small>
                        <strong>@Model.PublishedAt.Value.ToString("MMM dd, yyyy h:mm tt")</strong>
                    </div>
                }
            </div>
        </div>

        <div class="d-grid gap-2">
            @if (Model.Status == SafeX.CompanyPanel.Models.JobStatus.Draft)
            {
                <form asp-action="Publish" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirmAction(this, 'Publish this job?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-lg"></i> Publish Job</button>
                </form>
            }
            @if (Model.Status == SafeX.CompanyPanel.Models.JobStatus.Published)
            {
                <form asp-action="Close" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirmAction(this, 'Close this job?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning w-100"><i class="bi bi-x-lg"></i> Close Job</button>
                </form>
            }
        </div>
    </div>
</div>
