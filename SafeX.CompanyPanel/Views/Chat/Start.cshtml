@{
    ViewData["Title"] = "Chat";
    ViewData["ActivePage"] = "Applicants";
    var internId = ViewBag.InternId as int?;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="text-center py-5">
            <div class="display-1 text-primary mb-4">
                <i class="bi bi-chat-dots"></i>
            </div>
            <h2 class="fw-bold">Messaging Module</h2>
            <p class="text-muted lead mb-4">
                The real-time chat system for communicating with Intern #@internId
                will be integrated here by the messaging team.
            </p>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <i class="bi bi-hourglass-split display-4 text-warning d-block mb-3"></i>
                    <h5>Coming Soon</h5>
                    <p class="text-muted mb-0">
                        This chat entry point is ready for integration with the
                        messaging microservice. Route: <code>/Chat/Start/@internId</code>
                    </p>
                </div>
            </div>
            <a asp-controller="Applicant" asp-action="Index" class="btn btn-primary mt-4">
                <i class="bi bi-arrow-left"></i> Back to Applicants
            </a>
        </div>
    </div>
</div>
