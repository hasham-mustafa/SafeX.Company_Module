@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h1 class="display-4 fw-bold">Error</h1>
    <p class="lead text-muted">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <small>Request ID: <code>@Model.RequestId</code></small>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        <i class="bi bi-house"></i> Go Home
    </a>
</div>
