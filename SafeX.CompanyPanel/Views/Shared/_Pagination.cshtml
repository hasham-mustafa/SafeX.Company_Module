@model PagedResult<dynamic>
@{
    string BuildPageUrl(int page)
    {
        var query = Context.Request.Query
            .Where(q => q.Key != "page")
            .Select(q => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(q.Value.ToString())}");
        var queryString = string.Join("&", query.Append($"page={page}"));
        return Context.Request.Path + "?" + queryString;
    }
}

@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4 px-2">
        <small class="text-muted">
            Showing <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
            to <strong>@Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)</strong>
            of <strong>@Model.TotalCount</strong> results
        </small>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="@BuildPageUrl(Model.PageNumber - 1)" tabindex="-1">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    @if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="@BuildPageUrl(i)">@i</a>
                        </li>
                    }
                    else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                    {
                        <li class="page-item disabled"><a class="page-link">...</a></li>
                    }
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="@BuildPageUrl(Model.PageNumber + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
