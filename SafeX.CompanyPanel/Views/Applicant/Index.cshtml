@model ApplicantSearchViewModel
@{
    ViewData["Title"] = "All Applicants";
    ViewData["ActivePage"] = "Applicants";
    var jobs = ViewBag.Jobs as IEnumerable<SafeX.CompanyPanel.Models.Job> ?? Enumerable.Empty<SafeX.CompanyPanel.Models.Job>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-people"></i> All Applicants</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Applicants</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, email, skills..."
                           value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="Reviewed" selected="@(Model.StatusFilter == "Reviewed")">Reviewed</option>
                    <option value="Shortlisted" selected="@(Model.StatusFilter == "Shortlisted")">Shortlisted</option>
                    <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Rejected</option>
                    <option value="Hired" selected="@(Model.StatusFilter == "Hired")">Hired</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Job</label>
                <select name="jobIdFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Jobs</option>
                    @foreach (var job in jobs)
                    {
                        <option value="@job.Id" selected="@(Model.JobIdFilter == job.Id)">@job.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Sort By</label>
                <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                    <option value="oldest" selected="@(Model.SortBy == "oldest")">Oldest</option>
                    <option value="name" selected="@(Model.SortBy == "name")">Name A-Z</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Applicants.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-3 text-muted"></i>
            <h4 class="mt-3 text-muted">@(string.IsNullOrEmpty(Model.SearchTerm) ? "No Applicants Yet" : "No Applicants Match Your Search")</h4>
            <p class="text-muted">@(string.IsNullOrEmpty(Model.SearchTerm) ? "Applications will appear here once candidates apply to your published jobs." : "Try adjusting your search or filter criteria.")</p>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Clear Filters
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Applicant</th>
                            <th>University</th>
                            <th>Skills</th>
                            <th>Bid</th>
                            <th>Status</th>
                            <th>Applied</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var applicant in Model.Applicants)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="applicant-avatar">
                                            @if (!string.IsNullOrEmpty(applicant.ProfilePicture))
                                            {
                                                <img src="@applicant.ProfilePicture" alt="@applicant.FirstName" />
                                            }
                                            else
                                            {
                                                <span>@applicant.FirstName[0]@applicant.LastName[0]</span>
                                            }
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@applicant.Id"
                                               class="text-decoration-none fw-semibold">@applicant.FirstName @applicant.LastName</a>
                                            <br><small class="text-muted">@applicant.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="small">@(applicant.University ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(applicant.Skills))
                                    {
                                        var skills = applicant.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(2);
                                        foreach (var skill in skills)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary me-1">@skill</span>
                                        }
                                        if (applicant.Skills.Split(',').Length > 2)
                                        {
                                            <span class="badge bg-secondary">+@(applicant.Skills.Split(',').Length - 2)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="fw-semibold text-success">
                                    @(applicant.BidAmount.HasValue ? $"{applicant.BidAmount:N0}" : "—")
                                </td>
                                <td>
                                    @switch (applicant.Status)
                                    {
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Pending:
                                            <span class="badge bg-secondary">Pending</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Reviewed:
                                            <span class="badge bg-info text-dark">Reviewed</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Shortlisted:
                                            <span class="badge bg-primary">Shortlisted</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Rejected:
                                            <span class="badge bg-danger">Rejected</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Hired:
                                            <span class="badge bg-success">Hired</span>
                                            break;
                                    }
                                </td>
                                <td class="small text-muted">@applicant.AppliedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@applicant.Id"
                                           class="btn btn-outline-info" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Portfolio" asp-route-id="@applicant.Id"
                                           class="btn btn-outline-primary" title="Portfolio"><i class="bi bi-person-badge"></i></a>
                                        @if (applicant.Status == SafeX.CompanyPanel.Models.ApplicantStatus.Pending ||
                                        applicant.Status == SafeX.CompanyPanel.Models.ApplicantStatus.Reviewed)
                                        {
                                            <form asp-action="Shortlist" asp-route-id="@applicant.Id" method="post" class="d-inline"
                                                  onsubmit="return confirmAction('Shortlist @applicant.FirstName @applicant.LastName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-primary" title="Shortlist"><i class="bi bi-check-lg"></i></button>
                                            </form>
                                            <form asp-action="Reject" asp-route-id="@applicant.Id" method="post" class="d-inline"
                                                  onsubmit="return confirmAction('Reject @applicant.FirstName @applicant.LastName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Reject"><i class="bi bi-x-lg"></i></button>
                                            </form>
                                        }
                                        @if (applicant.Status == SafeX.CompanyPanel.Models.ApplicantStatus.Shortlisted)
                                        {
                                            <a asp-action="OfferJob" asp-route-applicantId="@applicant.Id"
                                               asp-route-jobId="@applicant.JobId"
                                               class="btn btn-outline-success" title="Hire"><i class="bi bi-handshake"></i></a>
                                        }
                                        <a asp-controller="Chat" asp-action="Start" asp-route-internId="@applicant.Id"
                                           class="btn btn-outline-secondary" title="Chat"><i class="bi bi-chat-dots"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <partial name="_Pagination" model='new PagedResult<SafeX.CompanyPanel.Models.Applicant> {
        Items = Model.Applicants,
        TotalCount = Model.TotalCount,
        PageNumber = Model.PageNumber,
        PageSize = Model.PageSize
    }' />
}
