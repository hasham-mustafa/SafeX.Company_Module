@model IEnumerable<SafeX.CompanyPanel.Models.Applicant>
@{
    ViewData["Title"] = $"Applicants — {ViewBag.JobTitle}";
    ViewData["ActivePage"] = "Applicants";
    var jobId = ViewBag.JobId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-people"></i> Applicants for <span class="text-primary">@ViewBag.JobTitle</span>
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Applicants</a></li>
                <li class="breadcrumb-item active">@ViewBag.JobTitle</li>
            </ol>
        </nav>
    </div>
    <a asp-controller="Job" asp-action="Details" asp-route-id="@jobId" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-briefcase"></i> View Job
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-3 text-muted"></i>
            <h4 class="mt-3 text-muted">No Applicants</h4>
            <p class="text-muted">No one has applied to this position yet.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Applicant</th>
                            <th>University</th>
                            <th>Skills</th>
                            <th>Bid</th>
                            <th>Status</th>
                            <th>Applied</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var applicant in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="applicant-avatar">
                                            @if (!string.IsNullOrEmpty(applicant.ProfilePicture))
                                            {
                                                <img src="@applicant.ProfilePicture" alt="@applicant.FirstName" />
                                            }
                                            else
                                            {
                                                <span>@applicant.FirstName[0]@applicant.LastName[0]</span>
                                            }
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@applicant.Id"
                                               class="text-decoration-none fw-semibold">@applicant.FirstName @applicant.LastName</a>
                                            <br><small class="text-muted">@applicant.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="small">@(applicant.University ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(applicant.Skills))
                                    {
                                        var skills = applicant.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(2);
                                        foreach (var skill in skills)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary me-1">@skill</span>
                                        }
                                        if (applicant.Skills.Split(',').Length > 2)
                                        {
                                            <span class="badge bg-secondary">+@(applicant.Skills.Split(',').Length - 2)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="fw-semibold text-success">@(applicant.BidAmount.HasValue ? $"{applicant.BidAmount:N0}" : "—")</td>
                                <td>
                                    @switch (applicant.Status)
                                    {
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Pending:
                                            <span class="badge bg-secondary">Pending</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Reviewed:
                                            <span class="badge bg-info text-dark">Reviewed</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Shortlisted:
                                            <span class="badge bg-primary">Shortlisted</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Rejected:
                                            <span class="badge bg-danger">Rejected</span>
                                            break;
                                        case SafeX.CompanyPanel.Models.ApplicantStatus.Hired:
                                            <span class="badge bg-success">Hired</span>
                                            break;
                                    }
                                </td>
                                <td class="small text-muted">@applicant.AppliedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@applicant.Id"
                                           class="btn btn-outline-info"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Portfolio" asp-route-id="@applicant.Id"
                                           class="btn btn-outline-primary"><i class="bi bi-person-badge"></i></a>
                                        @if (applicant.Status == SafeX.CompanyPanel.Models.ApplicantStatus.Pending ||
                                        applicant.Status == SafeX.CompanyPanel.Models.ApplicantStatus.Reviewed)
                                        {
                                            <form asp-action="Shortlist" asp-route-id="@applicant.Id" method="post" class="d-inline"
                                                  onsubmit="return confirmAction('Shortlist @applicant.FirstName @applicant.LastName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-check-lg"></i></button>
                                            </form>
                                            <form asp-action="Reject" asp-route-id="@applicant.Id" method="post" class="d-inline"
                                                  onsubmit="return confirmAction('Reject @applicant.FirstName @applicant.LastName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-lg"></i></button>
                                            </form>
                                        }
                                        @if (applicant.Status == SafeX.CompanyPanel.Models.ApplicantStatus.Shortlisted)
                                        {
                                            <a asp-action="OfferJob" asp-route-applicantId="@applicant.Id"
                                               asp-route-jobId="@applicant.JobId"
                                               class="btn btn-outline-success"><i class="bi bi-handshake"></i></a>
                                        }
                                        <a asp-controller="Chat" asp-action="Start" asp-route-internId="@applicant.Id"
                                           class="btn btn-outline-secondary"><i class="bi bi-chat-dots"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
