@model IEnumerable<SafeX.CompanyPanel.Models.Hire>
@{
    ViewData["Title"] = "Hires";
    ViewData["ActivePage"] = "Hires";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-handshake"></i> Hires & Offers</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Hires</li>
            </ol>
        </nav>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-handshake display-3 text-muted"></i>
            <h4 class="mt-3 text-muted">No Hires Yet</h4>
            <p class="text-muted">When you shortlist an applicant and offer them a job, it will appear here.</p>
            <a asp-controller="Applicant" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-people"></i> Browse Applicants
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Applicant</th>
                            <th>Email</th>
                            <th>Job Position</th>
                            <th>Salary Offered</th>
                            <th>Status</th>
                            <th>Offered Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hire in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @(hire.Applicant?.FirstName ?? "N/A") @(hire.Applicant?.LastName ?? "")
                                </td>
                                <td class="small">@(hire.Applicant?.Email ?? "—")</td>
                                <td>@(hire.Job?.Title ?? "N/A")</td>
                                <td>
                                    @if (hire.SalaryOffered.HasValue)
                                    {
                                        <span class="fw-bold text-success">@hire.SalaryOffered.Value.ToString("N0")</span>
                                        <small class="text-muted">PKR</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @switch (hire.Status)
                                    {
                                        case SafeX.CompanyPanel.Models.HireStatus.Pending:
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
                                                <i class="bi bi-hourglass"></i> Pending
                                            </span>
                                            break;
                                        case SafeX.CompanyPanel.Models.HireStatus.Accepted:
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-circle"></i> Accepted
                                            </span>
                                            break;
                                        case SafeX.CompanyPanel.Models.HireStatus.Rejected:
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                                <i class="bi bi-x-circle"></i> Rejected
                                            </span>
                                            break;
                                        case SafeX.CompanyPanel.Models.HireStatus.Completed:
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                                                <i class="bi bi-check-all"></i> Completed
                                            </span>
                                            break;
                                        case SafeX.CompanyPanel.Models.HireStatus.Cancelled:
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">
                                                <i class="bi bi-slash-circle"></i> Cancelled
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="small text-muted">@hire.OfferedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (hire.Status == SafeX.CompanyPanel.Models.HireStatus.Pending)
                                    {
                                        <form asp-action="CancelHire" asp-route-id="@hire.Id" method="post"
                                              onsubmit="return confirmAction('Cancel this job offer for @(hire.Applicant?.FirstName ?? "this applicant")?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-x-lg"></i> Cancel Offer
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
