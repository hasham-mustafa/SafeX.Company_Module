@model SafeX.CompanyPanel.Services.Interfaces.CompanyDashboardStats
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-speedometer2"></i> Dashboard
        </h2>
        <p class="text-muted mb-0">
            Welcome back, <strong class="text-primary">@Model.CompanyName</strong>
            <span class="ms-2 small">
                @if (Model.IsVerified)
                {
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-patch-check-fill"></i> Verified</span>
                }
                else
                {
                    <span class="badge bg-warning-subtle text-warning"><i class="bi bi-exclamation-circle"></i> Not Verified</span>
                }
            </span>
        </p>
    </div>
    <div>
        <a asp-controller="Job" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Post New Job
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm stat-card stat-card-primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="stat-label">Total Jobs</p>
                        <h3 class="stat-value mb-0">@Model.TotalJobs</h3>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>
                </div>
                <div class="stat-footer mt-2">
                    <a asp-controller="Job" asp-action="Index" class="text-decoration-none small">
                        View all jobs <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm stat-card stat-card-success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="stat-label">Open Jobs</p>
                        <h3 class="stat-value mb-0">@Model.ActiveJobs</h3>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
                <div class="stat-footer mt-2">
                    <a asp-controller="Job" asp-action="Index" class="text-decoration-none small">
                        View open jobs <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm stat-card stat-card-info h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="stat-label">Total Applicants</p>
                        <h3 class="stat-value mb-0">@Model.TotalApplicants</h3>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <div class="stat-footer mt-2">
                    <a asp-controller="Applicant" asp-action="Index" class="text-decoration-none small">
                        View applicants <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm stat-card stat-card-warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="stat-label">Hired Interns</p>
                        <h3 class="stat-value mb-0">@Model.TotalHires</h3>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-handshake"></i>
                    </div>
                </div>
                <div class="stat-footer mt-2">
                    <a asp-controller="Dashboard" asp-action="Hires" class="text-decoration-none small">
                        View hires <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-briefcase"></i> Recent Jobs</h5>
                <a asp-controller="Job" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentJobs.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-4 text-muted"></i>
                        <h5 class="mt-3 text-muted">No Jobs Posted Yet</h5>
                        <p class="text-muted">Post your first job to start receiving applications.</p>
                        <a asp-controller="Job" asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle"></i> Post New Job
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Applicants</th>
                                    <th>Posted</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model.RecentJobs)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a asp-controller="Job" asp-action="Details" asp-route-id="@job.Id"
                                               class="text-decoration-none">@job.Title</a>
                                        </td>
                                        <td><span class="badge bg-info-subtle text-info">@job.EmploymentType</span></td>
                                        <td>
                                            @switch (job.Status)
                                            {
                                                case SafeX.CompanyPanel.Models.JobStatus.Draft:
                                                    <span class="badge bg-secondary">Draft</span>
                                                    break;
                                                case SafeX.CompanyPanel.Models.JobStatus.Published:
                                                    <span class="badge bg-success">Published</span>
                                                    break;
                                                case SafeX.CompanyPanel.Models.JobStatus.Closed:
                                                    <span class="badge bg-warning text-dark">Closed</span>
                                                    break;
                                                case SafeX.CompanyPanel.Models.JobStatus.Filled:
                                                    <span class="badge bg-primary">Filled</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@job.Applicants.Count</td>
                                        <td class="text-muted small">@job.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-patch-check"></i> Verification Status</h5>
            </div>
            <div class="card-body">
                @if (Model.IsVerified)
                {
                    <div class="text-center py-3">
                        <div class="display-3 text-success mb-3">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <h5 class="fw-bold text-success">Verified Company</h5>
                        <p class="text-muted small">Your company is fully verified. You have access to all features.</p>
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <div class="display-3 text-warning mb-3">
                            <i class="bi bi-shield-exclamation"></i>
                        </div>
                        <h5 class="fw-bold">Verification Pending</h5>
                        @if (Model.PendingVerifications > 0)
                        {
                            <p class="text-muted small">
                                You have <strong class="text-warning">@Model.PendingVerifications</strong> document(s) under review.
                            </p>
                        }
                        else
                        {
                            <p class="text-muted small">No verification documents submitted yet.</p>
                        }
                        <a asp-controller="Company" asp-action="Verification" class="btn btn-warning btn-sm">
                            <i class="bi bi-upload"></i> Submit Documents
                        </a>
                    </div>
                }

                @if (Model.ClosedJobs > 0 || Model.TotalHires > 0)
                {
                    <hr />
                    <div class="row text-center">
                        <div class="col-6">
                            <h5 class="fw-bold text-secondary mb-0">@Model.ClosedJobs</h5>
                            <small class="text-muted">Closed Jobs</small>
                        </div>
                        <div class="col-6">
                            <h5 class="fw-bold text-success mb-0">@Model.TotalHires</h5>
                            <small class="text-muted">Total Hires</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-people"></i> Recent Applicants</h5>
                <a asp-controller="Applicant" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentApplicants.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-4 text-muted"></i>
                        <h5 class="mt-3 text-muted">No Applicants Yet</h5>
                        <p class="text-muted">Applications will appear here once candidates apply to your jobs.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Job</th>
                                    <th>Status</th>
                                    <th>Applied</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var applicant in Model.RecentApplicants)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a asp-controller="Applicant" asp-action="Details" asp-route-id="@applicant.Id"
                                               class="text-decoration-none">@applicant.FirstName @applicant.LastName</a>
                                        </td>
                                        <td class="small">@applicant.Email</td>
                                        <td class="small">@(applicant.Job?.Title ?? "—")</td>
                                        <td>
                                            @switch (applicant.Status)
                                            {
                                                case SafeX.CompanyPanel.Models.ApplicantStatus.Pending:
                                                    <span class="badge bg-secondary">Pending</span>
                                                    break;
                                                case SafeX.CompanyPanel.Models.ApplicantStatus.Reviewed:
                                                    <span class="badge bg-info text-dark">Reviewed</span>
                                                    break;
                                                case SafeX.CompanyPanel.Models.ApplicantStatus.Shortlisted:
                                                    <span class="badge bg-primary">Shortlisted</span>
                                                    break;
                                                case SafeX.CompanyPanel.Models.ApplicantStatus.Rejected:
                                                    <span class="badge bg-danger">Rejected</span>
                                                    break;
                                                case SafeX.CompanyPanel.Models.ApplicantStatus.Hired:
                                                    <span class="badge bg-success">Hired</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-muted small">@applicant.AppliedAt.ToString("MMM dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-lightning"></i> Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-3">
                    <a asp-controller="Job" asp-action="Create" class="btn btn-outline-primary text-start d-flex align-items-center p-3">
                        <i class="bi bi-plus-circle fs-4 me-3"></i>
                        <div>
                            <div class="fw-semibold">Post New Job</div>
                            <small class="text-muted">Create a new internship or freelance position</small>
                        </div>
                    </a>
                    <a asp-controller="Company" asp-action="Verification" class="btn btn-outline-warning text-start d-flex align-items-center p-3">
                        <i class="bi bi-patch-check fs-4 me-3"></i>
                        <div>
                            <div class="fw-semibold">Submit Verification</div>
                            <small class="text-muted">Upload documents to verify your company</small>
                        </div>
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary text-start d-flex align-items-center p-3">
                        <i class="bi bi-gear fs-4 me-3"></i>
                        <div>
                            <div class="fw-semibold">Update Profile</div>
                            <small class="text-muted">Edit company information and settings</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
